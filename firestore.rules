rules_version = '2';

// Everything is denied unless a rule below allows it.
// Tests live in tests/rules/firestore.rules.test.ts — change those first.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isOwner(familyId) {
      return signedIn() && get(familyPath(familyId)).data.ownerId == request.auth.uid;
    }

    // getAfter lets a brand-new family's first batch (family + member + invite) validate.
    function isOwnerAfter(familyId) {
      return signedIn() && getAfter(familyPath(familyId)).data.ownerId == request.auth.uid;
    }

    function isInvitedTo(familyId) {
      return verifiedEmail()
        && get(/databases/$(database)/documents/invites/$(myEmail())).data.familyId == familyId;
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // config/access: { familyCreators: [lowercase emails] }. Managed with admin credentials only.
    function canCreateFamily() {
      return verifiedEmail()
        && myEmail() in get(/databases/$(database)/documents/config/access).data.familyCreators;
    }

    match /config/{doc} {
      allow read, write: if false;
    }

    // Keyed by lowercase email. One family per email.
    match /invites/{email} {
      allow get: if (verifiedEmail() && myEmail() == email) || isMember(resource.data.familyId);
      allow list: if isMember(resource.data.familyId);
      allow create: if isOwnerAfter(request.resource.data.familyId)
        && email == email.lower()
        && onlyKeys(['familyId', 'invitedBy', 'createdAt'])
        && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if isOwner(resource.data.familyId);
    }

    match /families/{familyId} {
      allow read: if isMember(familyId);
      // Only allowlisted accounts can start a family; everyone else joins by invite.
      // Stops any Google account from using this project (storage, calendar sync, email).
      allow create: if canCreateFamily()
        && request.resource.data.ownerId == request.auth.uid
        && onlyKeys(['name', 'ownerId', 'timezone', 'createdAt']);
      allow update: if isOwner(familyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && onlyKeys(['name', 'ownerId', 'timezone', 'createdAt']);

      match /members/{userId} {
        allow read: if isMember(familyId);
        // Lets the app check "have I joined yet?" before it is a member.
        allow get: if signedIn() && request.auth.uid == userId;
        allow create: if request.auth.uid == userId
          && (isOwnerAfter(familyId) || isInvitedTo(familyId))
          && request.resource.data.email == myEmail()
          && onlyKeys(['displayName', 'email', 'color', 'photoURL', 'joinedAt'])
          && isHexColor(request.resource.data.color);
        // `calendar` (connection status) is written by Cloud Functions only.
        allow update: if request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'color', 'photoURL'])
          && isHexColor(request.resource.data.color);
        allow delete: if request.auth.uid == userId || isOwner(familyId);

        // OAuth refresh tokens. Admin SDK (Cloud Functions) only.
        match /private/{doc} {
          allow read, write: if false;
        }
      }

      match /chores/{choreId} {
        function validRepeat(r) {
          return r is map && r.keys().hasOnly(['freq', 'interval', 'days'])
            && r.freq in ['daily', 'weekly', 'monthly']
            && r.interval is int && r.interval >= 1 && r.interval <= 52
            && (!('days' in r) || (r.days is list && r.days.size() <= 7));
        }
        function validChore() {
          let d = request.resource.data;
          return onlyKeys(['title', 'assigneeId', 'dueDate', 'dueTime', 'done', 'points', 'createdAt', 'createdBy', 'repeat', 'completions', 'doneBy'])
            && (!('repeat' in d) || d.repeat == null || validRepeat(d.repeat))
            && (!('completions' in d) || (d.completions is map && d.completions.size() <= 200))
            && (!('doneBy' in d) || d.doneBy == null || d.doneBy is string)
            && d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && (d.assigneeId == null || d.assigneeId is string)
            && (d.dueDate == null || isDateKey(d.dueDate))
            && (!('dueTime' in d) || d.dueTime == null
                || (d.dueTime is string && d.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
            && d.done is bool
            && d.points is int && d.points >= 0 && d.points <= 1000;
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && validChore();
      }

      match /mealPlans/{date} {
        function validMeal() {
          let d = request.resource.data;
          return onlyKeys(['breakfast', 'lunch', 'dinner', 'notes', 'updatedBy'])
            && d.breakfast is string && d.breakfast.size() <= 500
            && d.lunch is string && d.lunch.size() <= 500
            && d.dinner is string && d.dinner.size() <= 500
            && d.notes is string && d.notes.size() <= 2000;
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && isDateKey(date) && validMeal();
      }

      // Google events are written by the sync function (Admin SDK) only.
      match /events/{eventId} {
        function validManualEvent() {
          let d = request.resource.data;
          return onlyKeys(['source', 'sourceUserId', 'memberIds', 'title', 'start', 'end', 'allDay', 'startDate', 'endDate', 'location', 'createdAt'])
            && d.source == 'manual'
            && (!('memberIds' in d) || (d.memberIds is list && d.memberIds.size() <= 20))
            && d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && d.start is timestamp && d.end is timestamp && d.end >= d.start
            && d.allDay is bool
            && (!('startDate' in d) || isDateKey(d.startDate))
            && (!('endDate' in d) || isDateKey(d.endDate))
            && (!('location' in d) || (d.location is string && d.location.size() <= 300));
        }
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && validManualEvent()
          && request.resource.data.sourceUserId == request.auth.uid;
        allow update: if isMember(familyId)
          && resource.data.source == 'manual'
          && validManualEvent()
          && request.resource.data.sourceUserId == resource.data.sourceUserId;
        allow delete: if isMember(familyId) && resource.data.source == 'manual';
      }

      match /photos/{photoId} {
        // The file lives in Storage at storagePath (inside this family's folder).
        function validPhoto() {
          let d = request.resource.data;
          return onlyKeys(['storagePath', 'url', 'kind', 'width', 'height', 'thumbPath', 'thumbUrl', 'bytes', 'caption', 'uploadedBy', 'createdAt'])
            && d.storagePath is string && d.storagePath.matches('^families/' + familyId + '/photos/[^/]+$')
            && (!('thumbPath' in d) || (d.thumbPath is string && d.thumbPath.matches('^families/' + familyId + '/photos/[^/]+_thumb[.]jpg$')))
            && (!('thumbUrl' in d) || (d.thumbUrl is string && d.thumbUrl.size() <= 2000))
            && (!('bytes' in d) || (d.bytes is int && d.bytes >= 0 && d.bytes <= 300 * 1024 * 1024))
            && (!('url' in d) || (d.url is string && d.url.size() <= 2000))
            && (!('kind' in d) || d.kind in ['image', 'video'])
            && (!('caption' in d) || (d.caption is string && d.caption.size() <= 200))
            && (!('width' in d) || d.width is number)
            && (!('height' in d) || d.height is number);
        }
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validPhoto() && request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isMember(familyId)
          && validPhoto()
          && resource.data.uploadedBy == request.auth.uid
          && request.resource.data.uploadedBy == resource.data.uploadedBy;
        // Anyone in the household can remove any photo (and its file; see storage.rules).
        allow delete: if isMember(familyId);
      }

      // Star ledger: +stars when a chore is completed, -stars when a reward is redeemed.
      // Entries are immutable; undoing a chore deletes its entry.
      match /stars/{entryId} {
        function validEntry() {
          let d = request.resource.data;
          return onlyKeys(['memberId', 'delta', 'reason', 'choreId', 'rewardId', 'createdBy', 'createdAt'])
            && d.memberId is string
            && d.delta is int && d.delta >= -100000 && d.delta <= 100000
            && d.reason is string && d.reason.size() <= 200
            && (!('choreId' in d) || d.choreId == null || d.choreId is string)
            && (!('rewardId' in d) || d.rewardId == null || d.rewardId is string)
            && d.createdBy == request.auth.uid;
        }
        allow read, delete: if isMember(familyId);
        allow create: if isMember(familyId) && validEntry();
      }

      // Each person's Google calendars, mirrored by the sync function (Admin SDK creates/removes them).
      // The owner may show/hide, recolor, rename, and say who a calendar belongs to.
      match /calendars/{calendarKey} {
        allow read: if isMember(familyId);
        allow update: if isMember(familyId)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'color', 'alias', 'memberIds'])
          && request.resource.data.enabled is bool
          && isHexColor(request.resource.data.color)
          && (!('alias' in request.resource.data) || (request.resource.data.alias is string && request.resource.data.alias.size() <= 60))
          && request.resource.data.memberIds is list && request.resource.data.memberIds.size() >= 1 && request.resource.data.memberIds.size() <= 20;
      }

      // Grocery / to-do lists. Items can belong to a person's section (memberId) or the whole list (null).
      match /lists/{listId} {
        function validList() {
          let d = request.resource.data;
          return onlyKeys(['title', 'kind', 'sections', 'order', 'createdBy', 'createdAt', 'categories'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 80
            && (!('categories' in d) || (d.categories is list && d.categories.size() <= 30))
            && d.kind in ['grocery', 'todo', 'custom']
            && d.sections is bool
            && d.order is number;
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && validList();

        match /items/{itemId} {
          function validItem() {
            let d = request.resource.data;
            // expireAt: set when checked off; a TTL policy deletes the item then (firestore.indexes.json).
            return onlyKeys(['text', 'done', 'memberId', 'order', 'createdBy', 'createdAt', 'doneAt', 'updatedAt', 'categoryId', 'expireAt'])
              && d.text is string && d.text.size() > 0 && d.text.size() <= 300
              && d.done is bool
              && (!('memberId' in d) || d.memberId == null || d.memberId is string)
              && (!('categoryId' in d) || d.categoryId == null || (d.categoryId is string && d.categoryId.size() <= 40))
              && (!('expireAt' in d) || d.expireAt is timestamp)
              && d.order is number;
          }
          allow read, delete: if isMember(familyId);
          allow create, update: if isMember(familyId) && validItem();
        }
      }

      match /recipes/{recipeId} {
        function optList(d, k, max) {
          return !(k in d) || (d[k] is list && d[k].size() <= max);
        }
        function optMap(d, k) {
          return !(k in d) || d[k] == null || d[k] is map;
        }
        function optBoolean(d, k) {
          return !(k in d) || d[k] is bool;
        }
        function optNum(d, k) {
          return !(k in d) || d[k] == null || d[k] is number;
        }
        function validRecipe() {
          let d = request.resource.data;
          return onlyKeys(['title', 'servings', 'minutes', 'ingredients', 'steps', 'url', 'createdBy', 'createdAt', 'updatedAt',
              // Structured recipe system (cookbooks, web imports, cooking mode)
              'source', 'dedupeKey', 'yieldText', 'prepMinutes', 'cookMinutes', 'totalMinutes', 'items', 'stepList',
              'tags', 'tagsEdited', 'favorite', 'confidence', 'needsReview', 'edited', 'rating', 'credit', 'image', 'notes'])
            && (!('source' in d) || d.source == null || (d.source is map && d.source.type in ['manual', 'cookbook', 'online']))
            && optList(d, 'items', 100) && optList(d, 'stepList', 100)
            && optMap(d, 'tags') && optMap(d, 'rating')
            && optBoolean(d, 'favorite') && optBoolean(d, 'needsReview') && optBoolean(d, 'edited') && optBoolean(d, 'tagsEdited')
            && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 2000))
            && optNum(d, 'confidence') && optNum(d, 'prepMinutes') && optNum(d, 'cookMinutes') && optNum(d, 'totalMinutes')
            && d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.ingredients is string && d.ingredients.size() <= 5000
            && d.steps is string && d.steps.size() <= 10000
            && (!('servings' in d) || d.servings == null || (d.servings is int && d.servings >= 1 && d.servings <= 100))
            && (!('minutes' in d) || d.minutes == null || (d.minutes is int && d.minutes >= 0 && d.minutes <= 10000))
            && (!('url' in d) || d.url == null
                || (d.url is string && d.url.size() <= 500 && d.url.matches('^https?://.+')));
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && validRecipe();
      }

      // Uploaded cookbooks. The app creates the record for its own upload and can rename it;
      // parse status, counts, cover, and deletion belong to the Cloud Functions (cookbooks.ts).
      match /cookbooks/{bookId} {
        function validNewBook() {
          let d = request.resource.data;
          return onlyKeys(['title', 'format', 'storagePath', 'sizeBytes', 'status', 'createdBy', 'createdAt'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && d.format in ['epub', 'pdf']
            && d.storagePath == 'families/' + familyId + '/cookbooks/' + bookId + '/original.' + d.format
            && d.sizeBytes is int && d.sizeBytes > 0 && d.sizeBytes <= 300 * 1024 * 1024
            && d.status == 'uploading'
            && d.createdBy == request.auth.uid;
        }
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validNewBook();
        allow update: if isMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
        allow delete: if false;

        // Parse cursor and lease (Cloud Functions only).
        match /work/{doc} {
          allow read, write: if false;
        }
      }

      // Cooking progress, shared live while a recipe is being made. Temporary: deleted on
      // Done/Reset and expired by a TTL policy on expireAt (firestore.indexes.json).
      match /cookingSessions/{recipeId} {
        function validSession() {
          let d = request.resource.data;
          return onlyKeys(['servings', 'items', 'steps', 'step', 'startedBy', 'updatedAt', 'expireAt'])
            && (d.servings == null || (d.servings is int && d.servings >= 1 && d.servings <= 100))
            && d.items is list && d.items.size() <= 100
            && d.steps is list && d.steps.size() <= 100
            && d.step is int && d.step >= 0 && d.step <= 200
            && d.startedBy == request.auth.uid
            && d.expireAt is timestamp;
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && validSession();
      }

      // The catalog index: a few shard docs with one short entry per recipe, so browsing
      // reads a handful of documents. Cloud Functions keep it in sync (functions/src/recipeIndex.ts).
      match /recipeIndex/{shard} {
        allow read: if isMember(familyId);
        allow write: if false;
      }

      match /rewards/{rewardId} {
        function validReward() {
          let d = request.resource.data;
          return onlyKeys(['title', 'cost', 'memberId', 'emoji', 'createdAt', 'createdBy', 'redeemedAt', 'redeemedBy'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 100
            && d.cost is int && d.cost >= 1 && d.cost <= 100000
            && (d.memberId == null || d.memberId is string)
            && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16));
        }
        allow read, delete: if isMember(familyId);
        allow create, update: if isMember(familyId) && validReward();
      }

      // Family-wide display settings (settings/display) and the parental lock (settings/lock).
      // Every field is optional; the app fills in defaults.
      match /settings/{docId} {
        function optBool(d, k) {
          return !(k in d) || d[k] is bool;
        }
        function optIntIn(d, k, lo, hi) {
          return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
        }
        function optOneOf(d, k, values) {
          return !(k in d) || d[k] in values;
        }
        function optTime(d, k) {
          return !(k in d) || (d[k] is string && d[k].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
        }
        function validLocation(loc) {
          return loc is map && loc.keys().hasOnly(['label', 'lat', 'lon'])
            && loc.label is string && loc.label.size() <= 200
            && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
            && loc.lon is number && loc.lon >= -180 && loc.lon <= 180;
        }
        function validDisplay() {
          let d = request.resource.data;
          return onlyKeys([
              'calendarName', 'weekStartsOn', 'showCountdowns', 'colorCodeMultiProfile', 'shadeWeekends',
              'dimPastEvents', 'weekStartToday', 'monthStartCurrentWeek', 'scheduleDays', 'scheduleStartToday',
              'temperatureUnit', 'weatherLocation', 'weatherDetails', 'weatherAlerts', 'weatherView', 'weatherOnCalendar', 'textSize', 'density',
              'remindAtStart', 'remindBeforeEnabled', 'remindBeforeMinutes', 'remindChoresDue', 'reminderSound',
              'showPhotosTab', 'theme', 'accentColor', 'colorEventsBy',
              'sleepEnabled', 'sleepFrom', 'sleepTo',
              'screensaverEnabled', 'screensaverAfterMinutes', 'screensaverSeconds', 'screensaverShuffle',
              'hiddenTabs', 'homePanels', 'listDoneDays'])
            && (!('calendarName' in d) || (d.calendarName is string && d.calendarName.size() <= 80))
            && optIntIn(d, 'weekStartsOn', 0, 6)
            && optOneOf(d, 'showCountdowns', ['always', 'never'])
            && optBool(d, 'colorCodeMultiProfile') && optBool(d, 'shadeWeekends') && optBool(d, 'dimPastEvents')
            && optBool(d, 'weekStartToday') && optBool(d, 'monthStartCurrentWeek') && optBool(d, 'scheduleStartToday')
            && optIntIn(d, 'scheduleDays', 1, 14)
            && optOneOf(d, 'temperatureUnit', ['F', 'C'])
            && (!('weatherLocation' in d) || d.weatherLocation == null || validLocation(d.weatherLocation))
            && (!('weatherDetails' in d) || (d.weatherDetails is list && d.weatherDetails.size() <= 12))
            && optBool(d, 'weatherAlerts') && optBool(d, 'weatherOnCalendar')
            && (!('weatherView' in d) || validWeatherView(d.weatherView))
            && optOneOf(d, 'textSize', ['small', 'medium', 'large'])
            && optOneOf(d, 'density', ['compact', 'cozy', 'comfortable'])
            && optBool(d, 'remindAtStart') && optBool(d, 'remindBeforeEnabled')
            && optIntIn(d, 'remindBeforeMinutes', 1, 1440)
            && optBool(d, 'remindChoresDue') && optBool(d, 'reminderSound') && optBool(d, 'showPhotosTab')
            && optOneOf(d, 'theme', ['system', 'light', 'dark'])
            && optOneOf(d, 'colorEventsBy', ['person', 'calendar'])
            && optBool(d, 'sleepEnabled') && optTime(d, 'sleepFrom') && optTime(d, 'sleepTo')
            && optBool(d, 'screensaverEnabled') && optIntIn(d, 'screensaverAfterMinutes', 1, 120)
            && optIntIn(d, 'screensaverSeconds', 3, 300) && optBool(d, 'screensaverShuffle')
            && (!('accentColor' in d) || isHexColor(d.accentColor))
            && (!('hiddenTabs' in d) || validHiddenTabs(d.hiddenTabs))
            && (!('homePanels' in d) || validHiddenTabs(d.homePanels))
            && optIntIn(d, 'listDoneDays', 0, 365);
        }
        function validWeatherView(v) {
          return v is map && v.keys().hasOnly(['phone', 'tablet', 'desktop'])
            && optOneOf(v, 'phone', ['day', 'threeDay', 'week'])
            && optOneOf(v, 'tablet', ['day', 'threeDay', 'week'])
            && optOneOf(v, 'desktop', ['day', 'threeDay', 'week']);
        }
        // Per-device lists: side-bar sections hidden, and Home panels shown ({ phone?: [...], tablet?: [...], desktop?: [...] }).
        function tabList(h, k) {
          return !(k in h) || (h[k] is list && h[k].size() <= 12);
        }
        function validHiddenTabs(h) {
          return h is map && h.keys().hasOnly(['phone', 'tablet', 'desktop'])
            && tabList(h, 'phone') && tabList(h, 'tablet') && tabList(h, 'desktop');
        }
        // Pantry staples and the recipe sites online search may use.
        function validKitchen() {
          let d = request.resource.data;
          return onlyKeys(['staples', 'sites'])
            && d.staples is list && d.staples.size() <= 60
            && d.sites is list && d.sites.size() <= 30;
        }
        function validLock() {
          let d = request.resource.data;
          return onlyKeys(['enabled', 'pinHash', 'salt', 'lockAfterMinutes'])
            && d.enabled is bool
            && (!('pinHash' in d) || (d.pinHash is string && d.pinHash.size() == 64))
            && (!('salt' in d) || (d.salt is string && d.salt.size() <= 64))
            && optIntIn(d, 'lockAfterMinutes', 1, 240);
        }
        allow read: if isMember(familyId);
        allow create, update: if isMember(familyId)
          && ((docId == 'display' && validDisplay()) || (docId == 'lock' && validLock()) || (docId == 'kitchen' && validKitchen()));
      }

      match /reminderPrefs/{userId} {
        function validPrefs() {
          let d = request.resource.data;
          return onlyKeys(['eventEmailsEnabled', 'leadTimeMinutes', 'dailyDigestEnabled', 'digestHourLocal', 'timezone'])
            && (!('eventEmailsEnabled' in d) || d.eventEmailsEnabled is bool)
            && d.leadTimeMinutes is int && d.leadTimeMinutes >= 0 && d.leadTimeMinutes <= 10080
            && d.dailyDigestEnabled is bool
            && d.digestHourLocal is int && d.digestHourLocal >= 0 && d.digestHourLocal <= 23
            && d.timezone is string && d.timezone.size() <= 64;
        }
        allow read, delete: if isMember(familyId) && request.auth.uid == userId;
        allow create, update: if isMember(familyId) && request.auth.uid == userId && validPrefs();
      }
    }
  }
}
