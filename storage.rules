rules_version = '2';

// Family photos and videos live at families/{familyId}/photos/{file}.
// Tests: tests/rules/storage.rules.test.ts (change those first).
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(familyId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /families/{familyId}/photos/{file} {
      allow read, delete: if isMember(familyId);
      // Images up to 25 MB (the app shrinks them first), videos up to 200 MB.
      allow create: if isMember(familyId)
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 25 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 200 * 1024 * 1024));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
