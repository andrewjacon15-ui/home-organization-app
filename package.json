{
  "name": "home-organization-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --only auth,firestore,storage",
    "prebuild": "node scripts/fetch-voice.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm --prefix functions run lint",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:functions && npm run test:rules",
    "test:web": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-family-rules \"vitest run --config vitest.rules.config.ts\"",
    "verify": "npm run lint && npm run check:costs && npm run check:repo && npm test && npm run build && npm run check:bundle && npm run build --prefix functions && npm audit --omit=dev --audit-level=moderate && npm audit --omit=dev --audit-level=moderate --prefix functions",
    "deploy": "npm run verify && firebase deploy --only hosting,firestore,functions,storage",
    "test:functions": "npm --prefix functions test",
    "check:costs": "node scripts/check-costs.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vosk-browser": "0.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
